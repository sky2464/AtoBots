[Unit]
Description=AtoBots health check (no AI unless something is wrong)

[Service]
Type=oneshot
TimeoutStartSec=30min
User=@USER@
Environment=ATOBOTS_HOME=@HOME@
# The name before 0.1.0, for company scripts that still use it.
Environment=CLAUDEBOT_HOME=@HOME@
# Exit 1 means "findings were reported", not a unit failure.
ExecStart=-@ENGINE@/bin/cb doctor --notify
