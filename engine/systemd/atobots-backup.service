[Unit]
Description=AtoBots hourly backup snapshot and push
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=30min
User=@USER@
Environment=ATOBOTS_HOME=@HOME@
# The name before 0.1.0, for company scripts that still use it.
Environment=CLAUDEBOT_HOME=@HOME@
ExecStart=@ENGINE@/bin/cb backup now
