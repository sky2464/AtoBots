[Unit]
Description=AtoBots dispatcher
After=network.target

[Service]
User=@USER@
Environment=ATOBOTS_HOME=@HOME@
# The name before 0.1.0, for company scripts that still use it.
Environment=CLAUDEBOT_HOME=@HOME@
ExecStart=@ENGINE@/bin/cb dispatcher run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
