[Unit]
Description=AtoBots always-on Admin (Telegram), in tmux session admin-live
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
Environment=ATOBOTS_HOME=@HOME@
# The name before 0.1.0, for company scripts that still use it.
Environment=CLAUDEBOT_HOME=@HOME@
# Cap the always-on Admin tree. The value comes from run_memory_max.
# Interactive claude is also wrapped with systemd-run --pty MemoryMax
# in chat.py / admin serve.
MemoryMax=@MEMORY_MAX@
MemorySwapMax=0
# The supervisor keeps tmux session "admin-live" alive and ends it on stop.
# It must be the only process systemd kills: the tmux server may be the
# Owner's own, shared with his sessions.
ExecStart=@ENGINE@/bin/cb admin run
ExecStopPost=-/usr/bin/tmux kill-session -t =admin-live
# Always scrub the Telegram plugin .env on stop (token must not linger).
ExecStopPost=-@ENGINE@/bin/cb admin scrub-token
KillMode=process
Restart=always
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
